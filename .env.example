# Public application origin (no trailing slash)
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
ELECTION_DB=elections.sqlite
REGISTRATION_OPEN=true

# Brevo Free: up to 300 e-mails/day. Keep the account on Free; no paid upgrades.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Eleições Escolares

# Optional alternative provider (requires EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# Alternative HTTPS service that forwards messages to institutional SMTP.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Local development only: capture messages in ignored .mail/ files.
EMAIL_CAPTURE=false

# Optional PRIVATE test deployment: generated with scripts/create-test-config.mjs.
# Contains a salted password hash, never a plaintext password. Do not commit.
TEST_SEED_JSON=
# Optional migration from the previous Sites-authenticated owner identifier.
LEGACY_OWNER_ID=

# Fotos na infraestrutura Node; inclua esta pasta nos backups.
PHOTO_DIRECTORY=.uploads
