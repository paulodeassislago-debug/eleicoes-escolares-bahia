[Unit]
Description=Backup de banco e fotos das eleições escolares
After=eleicoes-escolares.service

[Service]
Type=oneshot
User=eleicoes
Group=eleicoes
WorkingDirectory=/opt/eleicoes-escolares/current
EnvironmentFile=/etc/eleicoes-escolares.env
ExecStart=/usr/bin/node deploy/vps/backup.mjs
UMask=0077
StateDirectory=eleicoes-escolares
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
